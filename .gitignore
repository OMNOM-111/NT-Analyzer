# Local market data exports are large and machine-specific.
/data/

# Backups and local environments.
/BACKUPS/
/.venv/
/.pytest_cache/
/NT-Analyzer/.venv/
/NT-Analyzer/.pytest_cache/

# Python caches and virtualenv artifacts.
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.py,cover

# C# / .NET / NinjaTrader bridge build outputs.
**/bin/
**/obj/
*.pdb
*.dll
*.exe
*.cache

# Visual Studio / VS Code / IDE files.
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NT-Analyzer runtime queues, outputs, reports, logs, and local state.
/NT-Analyzer/jobs/
/NT-Analyzer/data/batches/
/NT-Analyzer/data/commands/
/NT-Analyzer/data/reports/
/NT-Analyzer/data/profiles/
/NT-Analyzer/data/research/
