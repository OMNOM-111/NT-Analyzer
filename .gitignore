/NT-Analyzer/data/ops/
/NT-Analyzer/data/last_job.txt
/NT-Analyzer/logs/
/NT-Analyzer/_backup_before_restore_*/
/NT-Analyzer/research_archive/

# Keep only safe static catalog sources in Git.
/NT-Analyzer/data/catalog/*.json
!/NT-Analyzer/data/catalog/instrument_groups.json
!/NT-Analyzer/data/catalog/margins.json

# Temporary runtime/result/error/heartbeat artifacts.
**/heartbeat.json
**/heartbeat-*.json
**/result.json
**/result.json.tmp
**/result-*.json
**/result.tmp.json
**/error.json
**/error.json.tmp
**/error-*.json
**/error.tmp.json
**/*.json.tmp
**/*.json.bak
**/*.tmp

# Local logs and ad-hoc generated files.
/NT-Analyzer/docs/*.new
/NT-Analyzer/data/*.log
/NT-Analyzer/data/*.err
/NT-Analyzer/*.log
/NT-Analyzer/*.err
/NT-Analyzer/*.out
/NT-Analyzer/app/*.log

# Local machine-specific configs. Keep only safe example configs.
/NT-Analyzer/bridge/NTAnalyzerBridge.config.json
/NT-Analyzer/bridge/*.local.json
/NT-Analyzer/**/*.local.json
/NT-Analyzer/**/*.user.json

# Explicit audit/runtime artifacts called out before first public push.
/NT-Analyzer/data/ops/audit_log.jsonl
/NT-Analyzer/docs/audit/

