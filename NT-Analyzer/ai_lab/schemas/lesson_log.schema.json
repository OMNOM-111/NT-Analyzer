{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Lab Lesson (JSONL line)",
  "type": "object",
  "required": ["timestamp_utc", "lesson_id", "summary", "scope"],
  "properties": {
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "lesson_id": { "type": "string" },
    "summary": { "type": "string" },
    "scope": { "type": "string", "enum": ["global", "instrument", "family", "experiment", "user_research"] },
    "scope_key": { "type": ["string", "null"] },
    "source": { "type": "string", "enum": ["error_pattern", "rejection", "user_research", "postmortem", "demo_mismatch"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "rule": { "type": ["string", "null"] },
    "weight": { "type": "number" }
  }
}
