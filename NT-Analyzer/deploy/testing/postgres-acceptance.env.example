# StratForge — isolated PostgreSQL acceptance environment (example).
#
# Copy to deploy/testing/postgres-acceptance.env, fill in the host/port and the
# two passwords you set in provision-test-postgres.sql, then `chmod 600` it.
# These DSNs MUST point at a throwaway, non-Production PostgreSQL instance.
# The acceptance run truncates and rewrites every table.

# Migration/admin role — owns the schema, applies migrations, truncates between
# tests. Used as STRATFORGE_TEST_POSTGRES_ADMIN_URL.
STRATFORGE_TEST_POSTGRES_ADMIN_URL=postgresql://stratforge_test_admin:change-me-admin@127.0.0.1:5432/stratforge_acceptance

# Application role — the RLS-enforced, unprivileged role the app connects as.
# Used as STRATFORGE_TEST_POSTGRES_URL.
STRATFORGE_TEST_POSTGRES_URL=postgresql://stratforge_app:change-me-app@127.0.0.1:5432/stratforge_acceptance
