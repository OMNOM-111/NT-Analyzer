#!/usr/bin/env bash
# Canary worker process launcher for the real Supervisor topology (no
# systemd on the current host). Install as
# /home/stratforge/production_data/config/run-worker-canary.sh (chmod 0700,
# owner stratforge), then point the supervisord `worker-canary` program's
# `command=` at this script. Sources the isolated canary.env produced by
# tools/canary_isolation_provision.py -- never Production's env -- and
# overrides STRATFORGE_DEPLOYMENT_ROLE to worker (canary.env's own default
# is all-in-one, for the api program). Real isolated queue/heartbeats: see
# app.production_workers, gated on runtime_env.is_server_environment().
set -euo pipefail
umask 077
set -a
. /home/stratforge/production_data/config/canary.env
set +a
export STRATFORGE_DEPLOYMENT_ROLE=worker
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
cd /home/stratforge/canary-current
.venv/bin/python tools/production_preflight.py \
  --app-root /home/stratforge/canary-current \
  --env-file /home/stratforge/production_data/config/canary.env \
  --init-system supervisor
exec .venv/bin/python -m app.production_workers \
  --classes interactive_ai,chart,telemetry,maintenance \
  --poll-ms 250 --shutdown-grace-sec 60
