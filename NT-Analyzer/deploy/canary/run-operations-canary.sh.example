#!/usr/bin/env bash
# Canary operations/maintenance loop. Mirrors Production's
# run-operations-loop.sh but reads canary.env and never touches the
# Production data root. Install as
# /home/stratforge/production_data/config/run-operations-canary.sh.
set -euo pipefail
umask 077
set -a
. /home/stratforge/production_data/config/canary.env
set +a
export STRATFORGE_DEPLOYMENT_ROLE=worker PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
cd /home/stratforge/canary-current
.venv/bin/python tools/production_preflight.py \
  --app-root /home/stratforge/canary-current \
  --env-file /home/stratforge/production_data/config/canary.env
trap 'exit 0' TERM INT
while true; do
  if ! .venv/bin/python -m app.observability --maintenance; then
    sleep 30 & wait $!
  else
    sleep 60 & wait $!
  fi
done
