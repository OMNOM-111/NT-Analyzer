#!/usr/bin/env bash
# Canary Telegram consumer launcher for the real Supervisor topology (no
# systemd on the current host). Install as
# /home/stratforge/production_data/config/run-telegram-canary.sh (chmod 0700,
# owner stratforge), then point the supervisord `telegram-canary` program's
# `command=` at this script. Sources the isolated canary.env produced by
# tools/canary_isolation_provision.py -- never Production's env -- and
# overrides STRATFORGE_DEPLOYMENT_ROLE to telegram.
set -euo pipefail
umask 077
set -a
. /home/stratforge/production_data/config/canary.env
set +a
export STRATFORGE_DEPLOYMENT_ROLE=telegram
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
cd /home/stratforge/canary-current
.venv/bin/python tools/production_preflight.py \
  --app-root /home/stratforge/canary-current \
  --env-file /home/stratforge/production_data/config/canary.env \
  --init-system supervisor
exec .venv/bin/python -m app.production_telegram --poll-ms 250