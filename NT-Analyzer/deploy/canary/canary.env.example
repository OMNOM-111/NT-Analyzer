# Copy to ~/.config/stratforge/canary.env, replace every placeholder,
# then chmod 600. This file intentionally contains no secret values.
# Изменено GPT-5.5 через Codex по запросу owner; 2026-08-08 UTC; isolated auth, OTP and market-data contract.
#
# Canary is a fully separate contour from Production. Every identity below MUST
# differ from the Production identity. The Production reference identifiers near
# the bottom let the fail-closed isolation guard (assert_environment_isolation)
# reject an accidental Production/Canary collision at startup and preflight.
DEPLOYMENT_ENV=canary
STRATFORGE_INSTANCE_ID=stratforge-canary-01
STRATFORGE_DEPLOYMENT_ROLE=api
STRATFORGE_CONFIG_PROFILE=canary-primary
APP_VERSION=__RELEASE_VERSION__
RELEASE_CHANNEL=beta
BUILD_ID=__BUILD_ID__
GIT_COMMIT_SHA=__GIT_COMMIT_SHA__
ARTIFACT_SHA256=__ARTIFACT_SHA256__
BUILD_TIMESTAMP_UTC=__BUILD_TIMESTAMP_UTC__
DIRTY=0
STRATFORGE_REGION=canary

STRATFORGE_BIND_HOST=127.0.0.1
STRATFORGE_ALLOWED_HOSTS=canary.stratforges.com
STRATFORGE_PUBLIC_ORIGIN=https://canary.stratforges.com
STRATFORGE_EDGE_MODE=cloudflare-tunnel
STRATFORGE_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Dedicated Canary data root. It must never point inside the release directory
# or overlap the Production data root.
STRATFORGE_CANARY_DATA_ROOT=__STRATFORGE_HOME__/var/stratforge-canary
STRATFORGE_DATA_ROOT=__STRATFORGE_HOME__/var/stratforge-canary
STRATFORGE_DATABASE_ID=postgres-canary
STRATFORGE_QUEUE_ID=canary-jobs
STRATFORGE_OBJECT_STORAGE_ID=canary-artifacts
STRATFORGE_TELEGRAM_BOT_ID=canary-main
STRATFORGE_COOKIE_NAMESPACE=sf-canary
STRATFORGE_SIGNING_KEY_ID=canary-key-v1
STRATFORGE_LOG_NAMESPACE=canary
STRATFORGE_READINESS_MIN_FREE_MB=2048
STRATFORGE_API_MAX_INFLIGHT=24
STRATFORGE_API_BACKLOG=96
STRATFORGE_API_MAX_BODY_BYTES=1048576
STRATFORGE_WORKER_POLL_MS=250
STRATFORGE_WORKER_SHUTDOWN_GRACE_SEC=60
STRATFORGE_CONNECTOR_RELEASE_CATALOG=__STRATFORGE_HOME__/etc/connector-releases-canary.json

# Canary uses its own OAuth app, mail credential, Telegram bot and licensed
# market-data credential, all injected by the protected Canary secret provider.
# Required secret names: NTA_GOOGLE_CLIENT_SECRET, NTA_SMTP_PASSWORD,
# NTA_TELEGRAM_BOT_TOKEN, NTA_TELEGRAM_WEBHOOK_SECRET and a market-data key.
NTA_TELEGRAM_BOT_USERNAME=__CANARY_TELEGRAM_BOT_USERNAME__
NTA_GOOGLE_CLIENT_ID=__CANARY_GOOGLE_OAUTH_CLIENT_ID__
NTA_GOOGLE_REDIRECT_URI=https://canary.stratforges.com/api/auth/google/callback
NTA_EMAIL_AUTH_PROVIDER=smtp
NTA_SMTP_HOST=__CANARY_TRANSACTIONAL_SMTP_HOST__
NTA_SMTP_PORT=587
NTA_SMTP_USERNAME=__CANARY_TRANSACTIONAL_SMTP_USERNAME__
NTA_SMTP_FROM=StratForge Canary <login-canary@stratforges.com>
NTA_SMTP_SECURITY=starttls
NTA_SMTP_TIMEOUT_SEC=15
NTA_TOPSTEPX_REMOTE_SERVER_AUTHORIZED=0
NTA_TOPSTEPX_REDISTRIBUTION_AUTHORIZED=0
NTA_TOPSTEPX_DATA_MODE=sim
NTA_MARKET_DATA_HEALTHCHECK_INSTRUMENT=MNQ
NTA_MARKET_DATA_HEALTHCHECK_TIMEFRAME=1m
NTA_MARKET_DATA_READINESS_REFRESH_SEC=300
NTA_MARKET_DATA_READINESS_MAX_AGE_SEC=900

# Isolated Canary storage. Supply the Canary DSN from the protected host secret
# provider; it must use a dedicated Canary database and role, never Production.
# Leave commented until the separate Canary database is really provisioned.
# STRATFORGE_STORAGE_MODE=postgresql
# STRATFORGE_DATABASE_URL=__FROM_PROTECTED_CANARY_SECRET_PROVIDER__
STRATFORGE_ARTIFACT_ROOT=__STRATFORGE_HOME__/var/stratforge-canary-artifacts
STRATFORGE_DEFAULT_WORKSPACE_QUOTA_BYTES=5368709120
STRATFORGE_MAX_ARTIFACT_BYTES=268435456
STRATFORGE_ARTIFACT_MIN_FREE_BYTES=2147483648
STRATFORGE_DATABASE_CONNECT_TIMEOUT_SEC=5

# Live money and real payments stay disabled in Canary.
STRATFORGE_LIVE_TRADING_ALLOWED=0
STRATFORGE_REAL_PAYMENTS_ALLOWED=0

# Telegram: a SEPARATE Canary bot token and webhook secret, provisioned
# out-of-band. Never reuse the Production bot token or webhook secret.
# NTA_TELEGRAM_BOT_TOKEN=__FROM_PROTECTED_CANARY_SECRET_PROVIDER__
# NTA_TELEGRAM_WEBHOOK_SECRET=__FROM_PROTECTED_CANARY_SECRET_PROVIDER__

# Production reference identifiers (no secrets). These let the startup and
# preflight isolation guard fail closed if any Canary identity above is ever set
# equal to the Production identity. Keep them in sync with production.env.
STRATFORGE_PRODUCTION_DATABASE_ID=postgres-primary
STRATFORGE_PRODUCTION_QUEUE_ID=production-jobs
STRATFORGE_PRODUCTION_OBJECT_STORAGE_ID=production-artifacts
STRATFORGE_PRODUCTION_TELEGRAM_BOT_ID=production-main
STRATFORGE_PRODUCTION_COOKIE_NAMESPACE=sf-prod
STRATFORGE_PRODUCTION_SIGNING_KEY_ID=production-key-v1
STRATFORGE_PRODUCTION_LOG_NAMESPACE=production
STRATFORGE_PRODUCTION_INSTANCE_ID=stratforge-prod-01
STRATFORGE_PRODUCTION_PUBLIC_ORIGIN=https://app.stratforges.com
STRATFORGE_PRODUCTION_ALLOWED_HOSTS=app.stratforges.com
STRATFORGE_PRODUCTION_DATA_ROOT=__STRATFORGE_HOME__/var/stratforge
# STRATFORGE_PRODUCTION_DATABASE_URL is a reference only; never store the
# Production DSN in the Canary environment file.
