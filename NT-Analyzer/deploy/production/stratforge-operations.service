[Unit]
Description=StratForge Production Operations Maintenance
Documentation=file:%h/apps/stratforge/current/docs/operations/PRODUCTION_OPERATIONS_RUNBOOK.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/stratforge/current
EnvironmentFile=%h/.config/stratforge/production.env
Environment=STRATFORGE_DEPLOYMENT_ROLE=worker
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=%h/apps/stratforge/current/.venv/bin/python tools/production_preflight.py --app-root %h/apps/stratforge/current
ExecStart=%h/apps/stratforge/current/.venv/bin/python -m app.observability --maintenance
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
