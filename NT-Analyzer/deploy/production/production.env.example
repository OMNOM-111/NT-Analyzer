# Copy to ~/.config/stratforge/production.env, replace every placeholder,
# then chmod 600. This file intentionally contains no secret values.
STRATFORGE_ENV=production
STRATFORGE_INSTANCE_ID=stratforge-prod-01
STRATFORGE_DEPLOYMENT_ROLE=api
STRATFORGE_CONFIG_PROFILE=production-primary
STRATFORGE_BUILD_VERSION=__RELEASE_VERSION__
STRATFORGE_BUILD_DATE=__RELEASE_DATE_YYYY_MM_DD__
STRATFORGE_RELEASE_CHANNEL=stable
STRATFORGE_REGION=primary

STRATFORGE_BIND_HOST=127.0.0.1
STRATFORGE_ALLOWED_HOSTS=app.stratforges.com
STRATFORGE_PUBLIC_ORIGIN=https://app.stratforges.com
STRATFORGE_EDGE_MODE=cloudflare-tunnel
STRATFORGE_TRUSTED_PROXY_IPS=127.0.0.1,::1

STRATFORGE_DATA_ROOT=__STRATFORGE_HOME__/var/stratforge
STRATFORGE_DATABASE_ID=postgres-primary
STRATFORGE_QUEUE_ID=production-jobs
STRATFORGE_OBJECT_STORAGE_ID=production-artifacts
STRATFORGE_TELEGRAM_BOT_ID=production-main
NTA_TELEGRAM_CHAT_ID=__FROM_PROTECTED_SECRET_PROVIDER__
STRATFORGE_OWNER_WORKSPACE_ID=ws_owner_EXPLICIT_CANONICAL_ID
STRATFORGE_COOKIE_NAMESPACE=sf-prod
STRATFORGE_SIGNING_KEY_ID=production-key-v1
# Public fingerprint only; the private release key never exists on this host.
STRATFORGE_RELEASE_SIGNING_KEY_FINGERPRINT=__SHA256_P256_PUBLIC_KEY_FINGERPRINT__
STRATFORGE_LOG_NAMESPACE=production
STRATFORGE_READINESS_MIN_FREE_MB=4096
STRATFORGE_API_MAX_INFLIGHT=48
STRATFORGE_API_BACKLOG=128
STRATFORGE_API_MAX_BODY_BYTES=1048576
STRATFORGE_WORKER_POLL_MS=250
STRATFORGE_WORKER_SHUTDOWN_GRACE_SEC=60
STRATFORGE_CONNECTOR_RELEASE_CATALOG=__STRATFORGE_HOME__/etc/connector-releases.json

# Authoritative Production storage. Supply the DSN from the protected host
# secret provider; it must use role stratforge_app, a dedicated database and
# sslmode=verify-full (or another explicitly approved TLS mode).
STRATFORGE_STORAGE_MODE=postgresql
STRATFORGE_DATABASE_URL=__FROM_PROTECTED_SECRET_PROVIDER__
STRATFORGE_ARTIFACT_ROOT=__STRATFORGE_HOME__/var/stratforge-artifacts
STRATFORGE_DEFAULT_WORKSPACE_QUOTA_BYTES=10737418240
STRATFORGE_MAX_ARTIFACT_BYTES=536870912
STRATFORGE_ARTIFACT_MIN_FREE_BYTES=4294967296
STRATFORGE_DATABASE_CONNECT_TIMEOUT_SEC=5

# Live money is a separate release gate. The first Production rollout is safe.
STRATFORGE_LIVE_TRADING_ALLOWED=0
STRATFORGE_REAL_PAYMENTS_ALLOWED=0
