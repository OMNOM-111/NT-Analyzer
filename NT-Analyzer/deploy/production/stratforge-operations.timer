[Unit]
Description=Schedule StratForge Production Operations Maintenance
Documentation=file:%h/apps/stratforge/current/docs/operations/PRODUCTION_OPERATIONS_RUNBOOK.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=15s
RandomizedDelaySec=10s
Persistent=true
Unit=stratforge-operations.service

[Install]
WantedBy=timers.target
